{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["mcp/**/*.ts", "api/**/*.ts", "src/server/**/*.ts", "src/geometry/**/*.ts", "src/typography/**/*.ts", "src/font-engine/OpenTypeExporter.ts"]
}
